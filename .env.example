# ---------------------------------------------------------------------------
# AL-KABIR — Environment Variables
# Copy to `.env.local` (dev) or set in your hosting provider (production).
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# === Admin authentication (required to enable the admin dashboard) ==========
# Password required to sign in at /admin/login
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional username (defaults to "admin")
ADMIN_USERNAME=admin
# HMAC signing secret for the session cookie. MUST be >= 16 chars, random.
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string-min-16-chars
# Optional session lifetime in hours (default 12)
AUTH_TTL_HOURS=12

# === Content persistence backend ===========================================
# "fs"     → writes content/*.json on local disk (development only)
# "github" → commits content/*.json via the GitHub API (production)
# If unset: "github" when GITHUB_TOKEN is present, else "fs".
CONTENT_STORAGE=

# --- GitHub backend (required in production / read-only filesystems) --------
# A fine-grained PAT with "Contents: Read and write" on the target repo.
GITHUB_TOKEN=
GITHUB_OWNER=spirerise
GITHUB_REPO=alkabir
# Branch to commit content to (default "main")
GITHUB_BRANCH=main
# Commit author shown in git history (optional)
GITHUB_AUTHOR_NAME=AL-KABIR CMS
GITHUB_AUTHOR_EMAIL=cms@alkabirmachineryrentals.ae

# === Existing integrations (unchanged) ======================================
# Google Analytics 4 measurement id (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Appwrite — used ONLY for form submissions (quotes/contacts/etc.), not content
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_QUOTES_COLLECTION_ID=quotes
NEXT_PUBLIC_APPWRITE_CONTACTS_COLLECTION_ID=contacts
NEXT_PUBLIC_APPWRITE_BOOKINGS_COLLECTION_ID=bookings
NEXT_PUBLIC_APPWRITE_SUBSCRIBERS_COLLECTION_ID=subscribers
NEXT_PUBLIC_APPWRITE_UPLOADS_BUCKET_ID=uploads
NEXT_PUBLIC_APPWRITE_DOCUMENTS_BUCKET_ID=documents
